---
// Первый экран внутренней страницы: хлебные крошки, вопрос посетителя, H1, подзаголовок, кнопки (слот actions).
interface Props {
  crumbs?: { href: string; label: string }[]
  ask?: string
  title: string
  lead?: string
  center?: boolean
}
const { crumbs = [], ask, title, lead, center = false } = Astro.props
---

<section class={`ph ${center ? 'ph--center' : ''}`}>
  <div class="wrap ph__wrap">
    {
      crumbs.length > 0 && (
        <nav class="ph__crumbs" aria-label="Навигация">
          <a href="/">Главная</a>
          {crumbs.map((c, i) =>
            i === crumbs.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>,
          )}
        </nav>
      )
    }
    {ask && <span class="q-ask">{ask}</span>}
    <h1 set:html={title} />
    {lead && <p class="ph__lead">{lead}</p>}
    {Astro.slots.has('actions') && <div class="ph__act"><slot name="actions" /></div>}
    <slot />
  </div>
</section>

<style>
  .ph {
    padding: clamp(36px, 6vw, 72px) 0 clamp(40px, 6vw, 72px);
    background:
      radial-gradient(55% 60% at 15% 0%, var(--lime-soft), transparent 70%),
      var(--bg);
  }
  .ph--center {
    text-align: center;
    background:
      radial-gradient(60% 55% at 50% 0%, var(--lime-soft), transparent 70%),
      var(--bg);
  }
  .ph__wrap {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .ph--center .ph__wrap {
    justify-items: center;
  }
  .ph__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 14px;
    color: var(--faint);
  }
  .ph__crumbs > * + *::before {
    content: '/';
    margin-right: 6px;
    color: var(--line-2);
  }
  .ph__crumbs a {
    color: var(--muted);
    text-decoration: none;
  }
  .ph__crumbs a:hover {
    color: var(--ink);
  }
  h1 {
    max-width: 17ch;
    font-size: clamp(38px, 6.2vw, 76px);
    line-height: 1;
    letter-spacing: -0.048em;
  }
  .ph__lead {
    max-width: 660px;
    font-size: clamp(17px, 1.9vw, 21px);
    color: var(--ink-2);
  }
  .ph__act {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4px;
  }
  .ph--center .ph__act {
    justify-content: center;
  }
</style>
