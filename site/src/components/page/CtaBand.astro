---
// Финальный тёмный блок страницы: вопрос, заголовок, кнопка регистрации.
interface Props {
  title: string
  lead?: string
  cta?: string
  href?: string
  place: string
}
const { title, lead, cta = 'Попробовать бесплатно', href = '/register', place } = Astro.props
---

<section class="section section--tight cta dark" aria-labelledby={`cta-${place}`}>
  <div class="wrap cta__wrap">
    <h2 id={`cta-${place}`}>{title}</h2>
    {lead && <p class="q-lead">{lead}</p>}
    <div class="cta__act">
      <a class="btn btn--lime btn--lg" href={href} data-goal="signup_click" data-goal-place={place}>{cta}</a>
      <slot />
    </div>
  </div>
</section>

<style>
  .cta {
    background: #141413;
  }
  .cta__wrap {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 18px;
    max-width: 820px;
  }
  .cta h2 {
    font-size: clamp(32px, 4.6vw, 56px);
  }
  .cta__act {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 6px;
  }
</style>
