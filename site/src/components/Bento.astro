---
// Секция 5: бенто-сетка возможностей + плитка «Вручную vs Толк». Заголовки плиток ведут на /vozmozhnosti/{slug}/ (ссылка растянута на всю плитку).
import { FEATURES } from '../lib/site.js'

const small = FEATURES.filter((f) =>
  ['avtopilot', 'perezapusk-kampanij', 'analitika', 'audit', 'sozdanie-kampanij', 'uvedomleniya-telegram', 'generaciya-izobrazhenij'].includes(f.slug),
)
const icons: Record<string, string> = {
  bolt: 'M13 2 4 14h7l-1 8 9-12h-7z',
  refresh: 'M20 11a8 8 0 1 0-2.3 5.7M20 5v6h-6',
  chart: 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  search: 'M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM21 21l-5-5',
  plus: 'M12 5v14M5 12h14',
  send: 'M22 2 11 13M22 2l-7 20-4-9-9-4z',
  image: 'M4 5h16v14H4zM4 16l5-5 4 4 3-3 4 4M15 9h.01',
}
---

<section class="section" id="vozmozhnosti" aria-labelledby="bento-h">
  <div class="wrap">
    <div class="q-head">
      <span class="q-ask">Что он умеет?</span>
      <h2 id="bento-h">Рутина Директа — за&nbsp;минуты, а&nbsp;не&nbsp;часы</h2>
    </div>

    <div class="bento">
      <article class="tile tile--chat reveal">
        <h3><a class="tile__link" href="/vozmozhnosti/ii-pomoshchnik/">ИИ-помощник</a></h3>
        <p>Спросите о кампаниях своими словами — ответ на данных Директа и Метрики, без жаргона.</p>
        <div class="mini-chat" aria-hidden="true">
          <span class="mini-chat__u">Что с заявками на этой неделе?</span>
          <span class="mini-chat__a">
            Заявок 41 (+6). Подорожали только в «Поиск — Москва»: там выросли ставки конкурентов. Предлагаю снизить ставку
            на 10% в вечерние часы.
          </span>
        </div>
      </article>

      <article class="tile tile--queries reveal">
        <h3><a class="tile__link" href="/vozmozhnosti/chistka-poiskovyh-zaprosov/">Чистка поисковых запросов</a></h3>
        <p>Мусорные запросы — в минус-фразы пачкой, с объяснением по каждому.</p>
        <ul class="mini-q" aria-hidden="true">
          <li><s>ремонт квартир своими руками</s><b>минус</b></li>
          <li><s>ремонт квартир вакансии</s><b>минус</b></li>
          <li>ремонт квартир под ключ цена<i>оставить</i></li>
          <li><s>ремонт квартир бесплатно</s><b>минус</b></li>
        </ul>
      </article>

      <article class="tile tile--summary reveal">
        <h3><a class="tile__link" href="/vozmozhnosti/svodka-kabinetov/">Сводка по всем кабинетам</a></h3>
        <p>Свои кабинеты и клиенты агентского аккаунта — проблемы на одном экране.</p>
        <ul class="mini-s" aria-hidden="true">
          <li><i class="d d--bad"></i>Стоматология «Улыбка»<span>3 правки</span></li>
          <li><i class="d d--warn"></i>Окна ПВХ Казань<span>1 правка</span></li>
          <li><i class="d d--ok"></i>Школа английского<span>всё ок</span></li>
        </ul>
      </article>

      <article class="tile tile--vs dark reveal">
        <h3>Вручную vs&nbsp;Толк</h3>
        <div class="vs">
          <div>
            <span class="vs__label">Вручную</span>
            <strong>~3 часа</strong>
            <small>в неделю на выгрузку запросов, площадок и сверку с Метрикой</small>
          </div>
          <span class="vs__mid">vs</span>
          <div class="vs__win">
            <span class="vs__label">С Толком</span>
            <strong>10 минут</strong>
            <small>прочитать сводку и одобрить правки</small>
          </div>
        </div>
        <p class="demo-note">Пример расчёта</p>
      </article>

      {
        small.map((f, i) => (
          <article class="tile tile--small reveal" style={`transition-delay:${(i % 4) * 0.05}s`}>
            <svg class="tile__ico" viewBox="0 0 24 24" aria-hidden="true">
              <path d={icons[f.icon]} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <h3><a class="tile__link" href={`/vozmozhnosti/${f.slug}/`}>{f.title}</a></h3>
            <p>{f.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tile:has(.tile__link) {
    position: relative;
  }
  .tile__link {
    color: inherit;
    text-decoration: none;
  }
  .tile__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .tile__link:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .tile__link:focus-visible {
    outline: none;
  }
  .tile:has(.tile__link:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .tile {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 24px;
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .tile h3 {
    font-size: 22px;
    letter-spacing: -0.025em;
  }
  .tile p {
    color: var(--muted);
    font-size: 15px;
  }
  .tile--chat {
    grid-column: span 2;
    grid-row: span 2;
  }
  .tile--queries,
  .tile--summary {
    grid-column: span 2;
  }
  .tile--vs {
    grid-column: span 2;
    background: #141413;
  }
  .tile--small h3 {
    font-size: 18px;
  }
  .tile__ico {
    width: 40px;
    height: 40px;
    padding: 9px;
    margin-bottom: 6px;
    border-radius: 12px;
    background: var(--lime-soft);
  }

  .mini-chat {
    display: grid;
    gap: 10px;
    margin-top: 18px;
    font-size: 15px;
  }
  .mini-chat__u {
    justify-self: end;
    padding: 9px 14px;
    border-radius: 16px 16px 5px 16px;
    background: var(--solid);
    color: var(--on-solid);
    font-weight: 600;
  }
  .mini-chat__a {
    padding: 14px 16px;
    border-radius: 16px 16px 16px 5px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    line-height: 1.5;
  }
  .mini-q,
  .mini-s {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: 14px;
  }
  .mini-q li,
  .mini-s li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 10px;
    background: var(--surface-2);
  }
  .mini-q s {
    color: var(--faint);
  }
  .mini-q b,
  .mini-q i,
  .mini-s span {
    margin-left: auto;
    font-size: 12px;
    font-weight: 700;
    font-style: normal;
    padding: 2px 8px;
    border-radius: var(--pill);
    white-space: nowrap;
  }
  .mini-q b {
    background: var(--lime);
  }
  .mini-q i {
    background: var(--ok-soft);
    color: var(--ok);
  }
  .mini-s span {
    background: var(--surface-3);
  }
  .d {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex: none;
  }
  .d--bad {
    background: var(--danger);
  }
  .d--warn {
    background: #d79a2b;
  }
  .d--ok {
    background: var(--ok);
  }

  .vs {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 14px;
    align-items: center;
    margin-top: 10px;
  }
  .vs > div {
    display: grid;
    gap: 2px;
    padding: 16px;
    border-radius: 16px;
    background: var(--surface-2);
  }
  .vs .vs__win {
    background: var(--lime);
    color: #141413;
  }
  .vs__label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }
  .vs strong {
    font-size: 30px;
    letter-spacing: -0.03em;
  }
  .vs small {
    font-size: 13px;
    opacity: 0.8;
  }
  .vs__mid {
    font-weight: 800;
    color: var(--faint);
  }

  @media (max-width: 1000px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
    .tile--chat {
      grid-row: auto;
    }
  }
  @media (max-width: 620px) {
    .bento {
      grid-template-columns: 1fr;
    }
    .tile--chat,
    .tile--queries,
    .tile--summary,
    .tile--vs {
      grid-column: auto;
    }
    .vs {
      grid-template-columns: 1fr;
    }
    .vs__mid {
      display: none;
    }
  }
</style>
