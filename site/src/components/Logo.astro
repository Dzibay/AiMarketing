---
// Знак «Толк»: пузырь диалога с галочкой одобрения на лаймовом квадрате + слово строчными.
interface Props { size?: number; wordmark?: boolean }
const { size = 32, wordmark = true } = Astro.props
---
<span class="logo">
  <svg width={size} height={size} viewBox="0 0 40 40" aria-hidden="true">
    <rect width="40" height="40" rx="11" fill="#c6f04a" />
    <path d="M10 8h20a4 4 0 0 1 4 4v11a4 4 0 0 1-4 4H19l-6 5v-5h-3a4 4 0 0 1-4-4V12a4 4 0 0 1 4-4z" fill="#141413" />
    <path d="M14 17.5l4 4 8-8" stroke="#c6f04a" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  {wordmark && <span class="logo__word">толк</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .logo__word {
    font-weight: 800;
    font-size: 24px;
    letter-spacing: -0.045em;
    line-height: 1;
    padding-bottom: 2px;
  }
</style>
