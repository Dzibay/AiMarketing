---
// Безопасность: только факты, подтверждённые кодом и политикой конфиденциальности (backend/app/legal.py).
import Base from '../layouts/Base.astro'
import PageHero from '../components/page/PageHero.astro'
import CtaBand from '../components/page/CtaBand.astro'
import Faq from '../components/Faq.astro'
import { faqLd } from '../lib/faq.js'
import { APP } from '../lib/site.js'

const crumbs = [{ href: '/bezopasnost/', label: 'Безопасность' }]
const email = import.meta.env.PUBLIC_SUPPORT_EMAIL || ''

const access = [
  {
    title: 'Вход через Яндекс',
    text: 'Директ и Метрика подключаются через официальный OAuth Яндекса. Пароль от Яндекса Толк не видит и не хранит.',
  },
  {
    title: 'Только нужные права',
    text: 'Толк запрашивает почту и имя аккаунта, чтение Метрики и доступ к API Директа. Права видны на экране Яндекса до подтверждения.',
  },
  {
    title: 'Ключи зашифрованы',
    text: 'Токены доступа к Яндексу хранятся в базе в зашифрованном виде и используются только для работы сервиса от вашего имени.',
  },
  {
    title: 'Отзыв в любой момент',
    text: 'Доступ можно отозвать в Яндекс ID, в разделе управления доступами. После этого Толк больше не сможет обращаться к вашему кабинету.',
  },
]

const control = [
  { title: 'Ничего без «Одобрить»', text: 'ИИ предлагает правки, но вносит их в Директ только после вашего подтверждения.' },
  { title: 'Журнал изменений', text: 'Каждое действие записывается: что изменилось, где, когда и по чьему решению.' },
  { title: 'Откат', text: 'Одобренную правку можно отменить одной кнопкой из журнала.' },
  { title: 'Правила в тестовом режиме', text: 'Новое автоправило сначала только показывает, что бы сделало. Включаете его вы.' },
]

const money = [
  { title: 'Не трогаем бюджет', text: 'Толк не пополняет баланс Директа. Рекламный бюджет вы платите Яндексу напрямую.' },
  { title: 'Не видим карту', text: 'Тариф оплачивается на странице ЮKassa. Данные карты сервис не получает и не хранит.' },
  { title: 'Данные не продаём', text: 'Данные передаются только Яндексу (по вашему поручению) и ЮKassa (для оплаты). Больше никому.' },
]

const faq = [
  {
    q: 'Может ли Толк что-то сломать в кабинете?',
    a: 'Правки вносятся только после вашего одобрения, каждая записывается в журнал и её можно откатить. Автоправила работают в границах, которые задали вы, и по умолчанию включаются в тестовом режиме.',
  },
  {
    q: 'Кто видит мои данные?',
    a: 'Вы и сервис, который обрабатывает их для ответов и предложений. Третьим лицам данные не продаются и не передаются, кроме Яндекса и ЮKassa в рамках работы сервиса и случаев, предусмотренных законом.',
  },
  {
    q: 'Как удалить аккаунт и данные?',
    a: 'Напишите в поддержку с адреса почты аккаунта. Доступ к Яндексу дополнительно можно отозвать в Яндекс ID. Сведения об оплатах хранятся в сроки, установленные налоговым законодательством.',
  },
]
---

<Base
  title="Безопасность и доступы — Толк"
  description="Как Толк работает с вашим Яндекс Директом: вход через OAuth Яндекса, зашифрованные ключи, правки только после одобрения, журнал и откат. Без доступа к деньгам и картам."
  jsonLd={[faqLd(faq)]}
  crumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    ask="А доступы и данные?"
    title="Ваш кабинет остаётся вашим"
    lead="Толк подключается к Директу через официальный вход Яндекса, ничего не меняет без вашего одобрения и не имеет доступа к деньгам."
  />

  <section class="section section--tight" aria-labelledby="acc-h">
    <div class="wrap">
      <div class="q-head">
        <span class="q-ask">Как Толк получает доступ?</span>
        <h2 id="acc-h">Доступ</h2>
      </div>
      <div class="tiles tiles--2">
        {
          access.map((f) => (
            <div class="tile reveal">
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight dark" aria-labelledby="ctl-h">
    <div class="wrap">
      <div class="q-head">
        <span class="q-ask">Он сам что-то поменяет?</span>
        <h2 id="ctl-h">Решения за вами</h2>
      </div>
      <div class="tiles tiles--2">
        {
          control.map((f) => (
            <div class="tile reveal">
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="money-h">
    <div class="wrap">
      <div class="q-head">
        <span class="q-ask">А деньги?</span>
        <h2 id="money-h">Деньги и данные</h2>
      </div>
      <div class="tiles">
        {
          money.map((f) => (
            <div class="tile reveal">
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </div>
          ))
        }
      </div>
      <p class="sc-docs">
        Подробно — в <a href={APP.privacy}>политике конфиденциальности</a> и <a href={APP.offer}>оферте</a>.
        {email && <>Вопросы о данных: <a href={`mailto:${email}`}>{email}</a>.</>}
      </p>
    </div>
  </section>

  <Faq items={faq} ask="А если…?" title="Вопросы о безопасности" lead="" />

  <CtaBand title="Посмотрите сами — это бесплатно" lead="Подключение через вход Яндекса. Отозвать доступ можно в любой момент." place="bezopasnost_final" />
</Base>

<style>
  .sc-docs {
    margin-top: 22px;
    color: var(--muted);
  }
</style>
