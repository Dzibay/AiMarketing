# Скопируйте в .env и заполните. Один файл на весь проект.
#   copy .env.example .env
#   docker compose up -d --build

# --- Обязательные ---

# Пароль Postgres
DB_PASSWORD=

# Пароль входа на /admin-panel
ADMIN_PASSWORD=

# Адрес сайта с https, например https://aimarketing.example (без слэша в конце).
# Callback Яндекса: {PUBLIC_BASE_URL}/api/web/yandex/callback
PUBLIC_BASE_URL=

# Приложение на https://oauth.yandex.ru
# Права: login:info, login:email, metrika:read, direct:api
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Секрет шифрования OAuth-токенов в БД. Длинная случайная строка (32+ символа).
TOKEN_ENCRYPT_SECRET=

# --- Необязательные ---

DB_USER=aimarketing
DB_NAME=aimarketing
DB_HOST=localhost
DB_PORT=5432

# Секрет подписи сессии админки. Если пусто, выводится из пароля.
ADMIN_TOKEN_SECRET=

# Секрет подписи сессий кабинета. Если пусто, выводится из ADMIN_TOKEN_SECRET.
WEB_SESSION_SECRET=
WEB_SESSION_TTL_DAYS=30

APP_NAME=AiMarketing

# Почта для сброса пароля (необязательно). Без SMTP ссылка пишется в лог backend.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_STARTTLS=true
# SMTP_SSL=false

# Telegram-бот для алертов по правилам (необязательно).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=MyAiMarketingBot
# TELEGRAM_WEBHOOK_SECRET=длинная_случайная_строка

# Вордстат для ИИ-ассистента (необязательно): Search API Yandex Cloud, 20 ₽ за 1000 запросов.
# Обычно пользователь подключает свой ключ в Настройках → Вордстат. Ключ сервиса ниже — для тех,
# у кого своего нет. Сервисный аккаунт с ролью search-api.webSearch.user, ключ с областью yc.search-api.execute.
# WORDSTAT_API_KEY=
# WORDSTAT_FOLDER_ID=

# Очередь задач и планировщик внутри API (локально true). В docker-compose API=false, сервис worker=true.
# RUN_EMBEDDED_WORKERS=true
# Сколько задач очереди (синки, статистика, правила) процесс выполняет параллельно.
# WORKER_CONCURRENCY=3
