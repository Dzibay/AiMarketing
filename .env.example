# Скопируйте в .env и заполните. Один файл на весь проект.
#   copy .env.example .env
#   docker compose up -d --build

# --- Обязательные ---

# Пароль Postgres
DB_PASSWORD=

# Пароль входа в админку /admin-panel. Админ — не пользователь кабинета: вход отдельный, только по паролю.
# Пусто — админка закрыта. Длинная случайная строка: 5 неверных попыток с адреса закрывают вход на 15 минут.
ADMIN_PASSWORD=

# Адрес сайта с https, например https://aimarketing.example (без слэша в конце).
# Callback Яндекса: {PUBLIC_BASE_URL}/api/web/yandex/callback
PUBLIC_BASE_URL=

# Приложение на https://oauth.yandex.ru
# Права: login:info, login:email, metrika:read, direct:api
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Необязательно: второе приложение только с правами audience:read, audience:write (тот же Callback URL) —
# ИИ сможет создавать новые LAL в Яндекс Аудиториях. Пусто — без новых LAL.
YANDEX_AUDIENCE_CLIENT_ID=
YANDEX_AUDIENCE_CLIENT_SECRET=

# Секрет шифрования OAuth-токенов в БД. Длинная случайная строка (32+ символа).
TOKEN_ENCRYPT_SECRET=

# --- Необязательные ---

DB_USER=aimarketing
DB_NAME=aimarketing
DB_HOST=localhost
DB_PORT=5432

# Секрет подписи сессий кабинета (и админки). Длинная случайная строка.
# Если пусто — выводится из старых ADMIN_TOKEN_SECRET / ADMIN_PASSWORD: на работающем сервере
# не удаляйте их, пока не зададите WEB_SESSION_SECRET, иначе все сессии сбросятся.
WEB_SESSION_SECRET=
WEB_SESSION_TTL_DAYS=30

APP_NAME=Толк

# Сайт tolk-ads.ru (site/) — вшивается при сборке образа nginx. Реквизиты, почта и телефон
# нужны для проверки сайта ЮKassa; без значения строка на сайте просто не выводится.
# PUBLIC_METRIKA_ID=12345678
# PUBLIC_LEGAL_LINE=Самозанятый Иванов Иван Иванович, ИНН 000000000000
# PUBLIC_SUPPORT_EMAIL=support@tolk-ads.ru
# PUBLIC_SUPPORT_PHONE=+7 900 000-00-00
# PUBLIC_SUPPORT_TELEGRAM=tolk_support

# Почта для сброса пароля и подтверждения почты при регистрации (необязательно).
# Без SMTP подтверждение почты выключено, а ссылки сброса пароля пишутся в лог backend.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_STARTTLS=true
# SMTP_SSL=false

# Telegram-бот для алертов по правилам (необязательно).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=TolkAdsBot
# TELEGRAM_WEBHOOK_SECRET=длинная_случайная_строка

# Очередь задач и планировщик внутри API (локально true). В docker-compose API=false, сервис worker=true.
# RUN_EMBEDDED_WORKERS=true
# Сколько задач очереди (синки, статистика, правила) процесс выполняет параллельно.
# WORKER_CONCURRENCY=3
